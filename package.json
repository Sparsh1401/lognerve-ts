{
  "name": "lognerve",
  "version": "0.1.0",
  "description": "SDK to trace LLM applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test tests/*.test.js",
    "format": "prettier --write .",
    "dev": "npm run build && node dist/index.js"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@arizeai/openinference-core": "^2.0.8",
    "@arizeai/openinference-semantic-conventions": "^2.3.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.216.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.216.0",
    "@opentelemetry/instrumentation": "^0.216.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1"
  },
  "peerDependencies": {
    "@arizeai/openinference-instrumentation-anthropic": "^0.1.10",
    "@arizeai/openinference-instrumentation-bedrock": "^0.4.14",
    "@arizeai/openinference-instrumentation-claude-agent-sdk": "^0.2.6",
    "@arizeai/openinference-instrumentation-langchain": "^4.0.12",
    "@arizeai/openinference-instrumentation-openai": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@arizeai/openinference-instrumentation-anthropic": { "optional": true },
    "@arizeai/openinference-instrumentation-bedrock": { "optional": true },
    "@arizeai/openinference-instrumentation-claude-agent-sdk": { "optional": true },
    "@arizeai/openinference-instrumentation-langchain": { "optional": true },
    "@arizeai/openinference-instrumentation-openai": { "optional": true }
  }
}
